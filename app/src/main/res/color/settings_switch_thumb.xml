<?xml version="1.0" encoding="utf-8"?>
<!-- Settings switch thumb: on = solid orange, off = white (light grey at night) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/settings_switch_thumb_off" android:state_enabled="false" />
    <item android:color="@color/primaryColor" android:state_checked="true" />
    <item android:color="@color/settings_switch_thumb_off" />
</selector>
