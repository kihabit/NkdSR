<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_toolbar_panel">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/strokeSizeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@color/black"
        android:text="@string/label_size"

        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/slider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/slider" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:stepSize="2"
        android:valueFrom="10"
        android:valueTo="50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/strokeSizeText"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbColor="@color/white"
        app:thumbElevation="4dp"
        app:thumbHeight="16dp"
        app:thumbRadius="8dp"
        app:thumbStrokeColor="@color/blue"
        app:thumbStrokeWidth="1dp"
        app:thumbWidth="16dp"
        app:tickVisible="false"
        app:trackHeight="4dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/redImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/red"
        app:layout_constraintBottom_toTopOf="@+id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/greenImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/greenImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/green"
        app:layout_constraintBottom_toTopOf="@+id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/blueImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/redImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/blueImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/blue"
        app:layout_constraintBottom_toTopOf="@id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/yellowImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/greenImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/yellowImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/yellow"
        app:layout_constraintBottom_toTopOf="@id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/cyanImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/blueImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cyanImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/cyan"
        app:layout_constraintBottom_toTopOf="@id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/whiteImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/yellowImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/whiteImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:background="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/colorPickerImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cyanImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/colorPickerImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintBottom_toTopOf="@id/colorPickerView"
        app:layout_constraintEnd_toStartOf="@+id/doneImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/whiteImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_goneMarginBottom="8dp"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@drawable/colors_svgrepo_com" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/doneImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toTopOf="@id/colorPickerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/colorPickerImage"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@drawable/ic_check" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/colorPickerImage" />

    <com.skydoves.colorpickerview.ColorPickerView
        android:id="@+id/colorPickerView"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:actionMode="always"
        app:initialColor="@color/red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        app:layout_goneMarginBottom="8dp" />
</androidx.constraintlayout.widget.ConstraintLayout>