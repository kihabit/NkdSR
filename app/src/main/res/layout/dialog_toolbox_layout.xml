<?xml version="1.0" encoding="utf-8"?>
<!-- Floating "Tools" popup (SSViewService.handleToolboxAction).
     Card: rounded white (dark grey in dark theme), orange header with matching top corners.
     Rows: icon 24dp · label (single line, takes the free space, never under the control) · switch / chip.
     All view ids are unchanged (the code binds to them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toolbox_card"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_toolbox_header"
        android:gravity="center"
        android:text="@string/notif_tools"
        android:textAlignment="gravity"
        android:textAppearance="@style/TextAppearance.Material3.ActionBar.Title"
        android:textColor="@color/onPrimaryColor" />

    <!-- Screenshot -->
    <LinearLayout
        android:id="@+id/screenshotView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/screenshotIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/screenshot"
            android:src="@drawable/ic_screenshot"
            app:tint="@color/toolbox_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/screenshotText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/screenshot"
            android:textColor="@color/toolbox_text"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchForScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/toolbox_switch_thumb"
            app:trackTint="@color/toolbox_switch_track"
            app:useMaterialThemeColors="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/toolbox_divider" />

    <!-- Facecam -->
    <LinearLayout
        android:id="@+id/faceCameView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/faceCameIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/facecam"
            android:src="@drawable/outline_camera_alt"
            app:tint="@color/toolbox_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/faceCameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/facecam"
            android:textColor="@color/toolbox_text"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchForFaceCame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/toolbox_switch_thumb"
            app:trackTint="@color/toolbox_switch_track"
            app:useMaterialThemeColors="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/toolbox_divider" />

    <!-- Drawing -->
    <LinearLayout
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/drawingViewIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/drawing"
            android:src="@drawable/ic_drawing"
            app:tint="@color/toolbox_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/drawingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/drawing"
            android:textColor="@color/toolbox_text"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFordrawing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/toolbox_switch_thumb"
            app:trackTint="@color/toolbox_switch_track"
            app:useMaterialThemeColors="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/toolbox_divider" />

    <!-- Video Quality -->
    <LinearLayout
        android:id="@+id/videoQualitySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/videoQualityIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/video_quality"
            android:src="@drawable/ic_videoq"
            app:tint="@color/toolbox_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/videoQualityLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/video_quality"
            android:textColor="@color/toolbox_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/selectVideoQualityCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbox_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/selectedVideoQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:maxWidth="130dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/toolbox_text"
                android:textSize="14sp"
                app:drawableEndCompat="@drawable/ic_chevron_small"
                app:drawableTint="@color/toolbox_subtext"
                tools:text="Original" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/toolbox_divider" />

    <!-- Audio Source -->
    <LinearLayout
        android:id="@+id/audioSourceSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/audioSourceIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/audio_source"
            android:src="@drawable/ic_audio_setting"
            app:tint="@color/toolbox_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audioSourceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/audio_source"
            android:textColor="@color/toolbox_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/selectAudioSourceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbox_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/selectedAudioSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:maxWidth="130dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/toolbox_text"
                android:textSize="14sp"
                app:drawableEndCompat="@drawable/ic_chevron_small"
                app:drawableTint="@color/toolbox_subtext"
                tools:text="Microphone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/toolbox_divider" />

    <!-- Countdown (sub-line "Countdown Time: 3 sec" under the label, tappable) -->
    <LinearLayout
        android:id="@+id/countdownBeforeStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/countdownBeforeStartIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/countdown_before_start"
            android:src="@drawable/ic_countdown_before_start"
            app:tint="@color/toolbox_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/countdownBeforeStartText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/countdown_before_start"
                android:textColor="@color/toolbox_text"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/countdownSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/toolbox_subtext"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Countdown Time: 3 sec"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchForCountDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/toolbox_switch_thumb"
            app:trackTint="@color/toolbox_switch_track"
            app:useMaterialThemeColors="false" />
    </LinearLayout>

</LinearLayout>
