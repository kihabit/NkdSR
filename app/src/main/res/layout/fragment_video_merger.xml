<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- VideoView (Main Preview Area) -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.70"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/videoView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playPauseButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoView"
        app:srcCompat="@drawable/ic_play" />
    <!-- Bottom Panel -->
    <!-- Add Video Button -->
    <ImageButton
        android:id="@+id/btnAddVideo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#FF6B35"
        android:contentDescription="@string/add_video"
        android:src="@android:drawable/ic_input_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playPauseButton"
        app:tint="#FFFFFF" />

    <!-- Thumbnail RecyclerView (horizontal scroll) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThumbnails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnAddVideo"
        app:layout_constraintTop_toTopOf="@+id/btnAddVideo" />

    <!-- ✅ Playhead marker — position is driven at runtime via marginStart
         (VideoMergerFragment.updateMarkerPosition), mirroring VideoTrimmerView's
         positionIcon. The strip itself no longer scrolls; this marker moves instead. -->
    <View
        android:id="@+id/markerPlayhead"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/primaryColor"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvThumbnails"
        app:layout_constraintStart_toStartOf="@id/rvThumbnails"
        app:layout_constraintTop_toTopOf="@id/rvThumbnails" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/totalTimeTextview"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        tools:text="Total Time: 10:00"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/rvThumbnails"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>