<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: section headers + rounded cards of rows (styles in values/styles_settings.xml).
     The activity toolbar shows the back arrow + "Settings" title. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/video" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- video_quality_label -->
                <LinearLayout
                    android:id="@+id/videoQualitySection"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_videoq" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/video_quality_label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/selectedVideoQuality"
                        style="@style/Settings.RowValue"
                        tools:text="Auto · 1080p" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />
                <!-- frame_rate -->
                <LinearLayout
                    android:id="@+id/frameRateSection"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_framerate" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/frame_rate" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/frameRateQuality"
                        style="@style/Settings.RowValue"
                        tools:text="Auto · 60 FPS" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/audio" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- audio_source_label -->
                <LinearLayout
                    android:id="@+id/audioSourceSection"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_audio_setting" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/audio_source_label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/selectedAudioSource"
                        style="@style/Settings.RowValue"
                        tools:text="Microphone" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_storage" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- save_location -->
                <LinearLayout
                    android:id="@+id/locationPath"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_save_outline" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/save_location" />

                        <TextView
                            android:id="@+id/selectedPathText"
                            style="@style/Settings.RowSubtitle"
                            android:maxLines="2"
                            android:ellipsize="middle"
                            tools:text="Moj" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/selectLocationPath"
                        style="@style/Settings.RowChevron" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_recording" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- countdown_before_start -->
                <LinearLayout
                    android:id="@+id/countdownBeforeStart"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_countdown_before_start" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/countdown_before_start" />

                        <!-- Tap the seconds to change them (as before); hidden while the switch is off -->
                        <TextView
                            android:id="@+id/countdownSeconds"
                            style="@style/Settings.RowSubtitle"
                            android:background="@drawable/bg_settings_row"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:visibility="gone"
                            tools:text="3 sec"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchForCountDown"
                        style="@style/Settings.Switch" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />
                <!-- keep_recording_screen_off -->
                <LinearLayout
                    android:id="@+id/keepRecordingInOffScreen"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_keeprecording" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/keep_recording_screen_off" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchForKeepRecording"
                        style="@style/Settings.Switch" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_floating_controls" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- hide_floating_ball_recording -->
                <LinearLayout
                    android:id="@+id/hideFloatingBall"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_hide_ball" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/hide_floating_ball_recording" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchForHideFloatingBall"
                        style="@style/Settings.Switch" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />
                <!-- notif_toolbar_title -->
                <LinearLayout
                    android:id="@+id/notificationToolbar"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_notif_small" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/notif_toolbar_title" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchForNotificationToolbar"
                        style="@style/Settings.Switch" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_about" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <!-- language -->
                <LinearLayout
                    android:id="@+id/languageSection"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_language" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/language" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/currentLanguageText"
                        style="@style/Settings.RowValue"
                        tools:text="English" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />
                <!-- rate_us -->
                <LinearLayout
                    android:id="@+id/rateUsSection"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:src="@drawable/ic_star_rate" />

                    <LinearLayout style="@style/Settings.RowText">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:text="@string/rate_us" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron" />
                </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
