<?xml version="1.0" encoding="utf-8"?>
<!-- Audio menu shown in place of the feature icons row: Music / Record / Volume + ✓ to close. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audioMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_dark_bg"
    android:clickable="true"
    android:focusable="true">

    <include
        android:id="@+id/itemMusic"
        layout="@layout/layout_video_options"
        android:layout_width="64dp"
        android:layout_height="62dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/itemRecord"
        layout="@layout/layout_video_options"
        android:layout_width="64dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/itemMusic"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/itemVideoVolume"
        layout="@layout/layout_video_options"
        android:layout_width="64dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/itemRecord"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnAudioMenuDone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_bg_white"
        android:contentDescription="@null"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_check"
        app:tint="@color/primaryColor" />

</androidx.constraintlayout.widget.ConstraintLayout>