<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    tools:ignore="ExtraText">
    <!-- Close Button (Cross at the top-right corner) -->
    <!-- Header Image -->
    <ImageView
        android:id="@+id/topEmojiImage"
        android:layout_width="401dp"
        android:layout_height="114dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        android:contentDescription="@string/emoji_description"
        android:src="@drawable/rateemoji" />



    <!-- Title -->
    <TextView
        android:id="@+id/rateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1A1A40"
        android:text="@string/rate_title_default"
        android:textSize="16sp"
        android:layout_marginStart="20dp"
        android:layout_below="@id/topEmojiImage"
        android:layout_centerHorizontal="true"
        android:paddingTop="16dp"
        android:textStyle="bold" />



    <!-- Rating Bar -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        android:layout_below="@id/rateTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:rating="0" />

    <!-- Image below Rating -->
    <ImageView
        android:id="@+id/imageBelowRating"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_below="@id/ratingBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        />

    <!-- Dot Image on top of 5th Star -->

    <!-- Submit Button -->

    <ImageView
        android:id="@+id/doteImage"
        android:layout_width="56dp"
        android:layout_height="102dp"
        android:layout_alignBottom="@id/ratingBar"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="-20dp"
        android:src="@drawable/dotimage_rateus" />

    <Button
        android:id="@+id/submit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/submit"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        android:layout_below="@id/imageBelowRating"
        android:layout_marginTop="16dp" />


</RelativeLayout>
