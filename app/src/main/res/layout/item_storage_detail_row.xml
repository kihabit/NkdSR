<?xml version="1.0" encoding="utf-8"?>
<!-- One Storage Details row: dot · label ········ value -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/dot"
        android:layout_width="@dimen/storage_dot_size"
        android:layout_height="@dimen/storage_dot_size"
        android:background="@drawable/bg_storage_dot" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:textColor="@color/storage_dialog_subtext"
        android:textSize="15sp"
        tools:text="Used" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/storage_dialog_text"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="59.37 GB" />
</LinearLayout>
