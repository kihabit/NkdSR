<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/shapeTitle"
        style="@style/TextAppearance.Material3.LabelLarge.Emphasized"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rectangleImage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/camera_rectangle_setting_background"
        app:layout_constraintBottom_toTopOf="@+id/rectangleTextView"
        app:layout_constraintEnd_toStartOf="@+id/circleImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shapeTitle"
        app:srcCompat="@drawable/ic_face"
        app:tint="@color/primaryColor" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/rectangleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/rectangle"
        android:textColor="@color/primaryColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/rectangleImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/rectangleImage"
        app:layout_constraintTop_toBottomOf="@+id/rectangleImage" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/circleImage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/camera_circle_setting_background"
        app:layout_constraintBottom_toTopOf="@+id/rectangleTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rectangleImage"
        app:layout_constraintTop_toBottomOf="@+id/shapeTitle"
        app:srcCompat="@drawable/ic_face" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/circleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/circleImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/circleImage"
        app:layout_constraintTop_toBottomOf="@+id/circleImage" />
</androidx.constraintlayout.widget.ConstraintLayout>