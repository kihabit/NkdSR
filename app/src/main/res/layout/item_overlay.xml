<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_editor_border">
        <!-- Main Text -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/overlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:padding="4dp"
            tools:text="Sample Text"
            android:textColor="@android:color/white"
            android:textSize="48sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/overlayImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Close Button (Top Left Corner Centered) -->
    <FrameLayout
        android:id="@+id/closeContainer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_circle_white">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/closeBtn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_close"
            android:tint="@android:color/black" />
    </FrameLayout>

    <!-- Resize Button (Bottom Right Corner Centered) -->
    <FrameLayout
        android:id="@+id/resizeContainer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_circle_white">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/resizeBtn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrows"
            android:tint="@android:color/black" />
    </FrameLayout>

    <!-- Edit (pencil) Button (Top Right Corner Centered) — text overlays only, toggled in code -->
    <FrameLayout
        android:id="@+id/editContainer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_circle_white"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/editBtn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_edit"
            android:tint="@android:color/black" />
    </FrameLayout>

</FrameLayout>