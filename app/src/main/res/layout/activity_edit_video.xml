<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_inshot_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/editor_inshot_bg"
        android:backgroundTint="@null"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/editor_inshot_bg"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ✅ Video box: toolbar aur play button ke beech ki bachi hui poori jagah khud leta hai -->
    <FrameLayout
        android:id="@+id/container"
        android:layoutDirection="ltr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toTopOf="@+id/playStopButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <com.nkd.screenrecorder.utils.CropOverlayView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playStopButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/featureRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_play1"
        app:tint="@color/white" />

    <!-- ✅ Fullscreen button (play button ki row mein, right side) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnFullscreen"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/playStopButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/playStopButton"
        app:srcCompat="@drawable/ic_fullscreen"
        app:tint="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnUndo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="@+id/playStopButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/playStopButton"
        app:srcCompat="@drawable/ic_undo"
        app:tint="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnRedo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="@+id/playStopButton"
        app:layout_constraintStart_toEndOf="@+id/btnUndo"
        app:layout_constraintTop_toTopOf="@+id/playStopButton"
        app:srcCompat="@drawable/ic_redo"
        app:tint="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/okTextOverlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="@drawable/circle_bg_white"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/playStopButton"
        app:layout_constraintBottom_toBottomOf="@id/playStopButton"
        app:srcCompat="@drawable/ic_check"
        app:tint="@color/primaryColor" />


    <!-- ✅ Icons row timeline ke theek upar chipki hai — timeline badhe to yeh upar khiskegi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/featureRecyclerView"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="@color/editor_inshot_bg"
        android:gravity="center"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/frameLayoutEditor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ✅ Timeline: sirf content jitni height (rows + thumbnails + ruler), neeche se chipki -->
    <FrameLayout
        android:id="@+id/frameLayoutEditor"
        android:layoutDirection="ltr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/editor_inshot_bg"
        android:foreground="@drawable/timeline_playhead"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ✅ Clip rows — height code (updateRowsAreaHeight) set karta hai:
                 0 rows = GONE, 1 row = 32dp ... max 4 rows = 128dp, uske baad scroll. -->
            <FrameLayout
                android:id="@+id/rowsViewport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipChildren="true">

                <HorizontalScrollView
                    android:id="@+id/timelineScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">


                        <LinearLayout
                            android:id="@+id/overlayTrackContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </FrameLayout>

                </HorizontalScrollView>

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/thumbnailRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- ✅ Time ruler — thumbnail scroll ke saath translationX se sync -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clipChildren="true">

                <FrameLayout
                    android:id="@+id/rulerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </FrameLayout>

        </LinearLayout>


    </FrameLayout>

    <!-- ✅ Current time (center) / total duration (right) — screen ke sabse neeche -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        tools:text="0:00.0"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTotalDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        tools:text="0:00.0"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvCurrentTime" />

    <!-- ✅ Audio menu (Music / Record / ✓) — sits exactly over the feature icons row -->
    <include
        android:id="@+id/audioMenu"
        layout="@layout/layout_audio_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/featureRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/featureRecyclerView" />

    <!-- ✅ Voice-over Record panel — bottom-anchored to the feature icons row, grows UPWARD -->
    <include
        android:id="@+id/recordPanel"
        layout="@layout/layout_record_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/featureRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/cropRatioSelector"
        layout="@layout/view_crop_ratio_selector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/featureRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomSheetView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/editorTextPanel"
            layout="@layout/bottom_sheet_dialog_textview_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/editorStickerPanel"
            layout="@layout/bottom_sheet_dialog_sticker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/musicPanel"
            layout="@layout/music_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ✅ Fullscreen se bahar aane ka button (sabse upar, sirf fullscreen mein dikhta hai) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnExitFullscreen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="@drawable/circle_bg_white"
        android:elevation="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_fullscreen_exit"
        app:tint="#000000" />

    <!-- ✅ Full-screen "Converting Video" export screen — above everything, blocks touches -->
    <include
        android:id="@+id/exportProgress"
        layout="@layout/layout_export_progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>