<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/video_item">

    <fragment
        android:id="@+id/video_item"
        android:name="com.nkd.screenrecorder.fragments.VideoFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_video" >
        <action
            android:id="@+id/action_video_item_to_editVideoActivity"
            app:destination="@id/editVideoActivity" />
    </fragment>
    <fragment
        android:id="@+id/image_item"
        android:name="com.nkd.screenrecorder.fragments.ImageFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_images">
        <action
            android:id="@+id/action_image_item_to_imagePreviewFragment"
            app:destination="@id/imagePreviewFragment" />
    </fragment>
    <fragment
        android:id="@+id/gif_item"
        android:name="com.nkd.screenrecorder.fragments.GIFFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_gif_item_to_imagePreviewFragment"
            app:destination="@id/imagePreviewFragment" />
    </fragment>
    <fragment
        android:id="@+id/menu_edit"
        android:name="com.nkd.screenrecorder.fragments.EditFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_menu_edit_to_videoTrimmerFragment"
            app:destination="@id/videoTrimmerFragment" />
        <action
            android:id="@+id/action_menu_edit_to_imageEditFragment"
            app:destination="@id/imageEditFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.nkd.screenrecorder.fragments.SettingFragment"
        android:label="@string/settings" />
    <fragment
        android:id="@+id/imagePreviewFragment"
        android:name="com.nkd.screenrecorder.fragments.ImagePreviewFragment"
        android:label="@string/image_preview">
        <argument
            android:name="imageList"
            app:argType="com.nkd.screenrecorder.model.ImageItem[]"
            app:nullable="true" />
        <argument
            android:name="gifList"
            app:argType="com.nkd.screenrecorder.model.GifItem[]"
            app:nullable="true" />
        <argument
            android:name="currentPosition"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_imagePreviewFragment_to_editImageFragment"
            app:destination="@id/editImageFragment" />
    </fragment>
    <fragment
        android:id="@+id/videoTrimmerFragment"
        android:name="com.nkd.screenrecorder.fragments.VideoTrimmerFragment"
        android:label="@string/select_video">
        <argument
            android:name="isTrim"
            android:defaultValue="true"
            app:argType="boolean"
            app:nullable="false" />

        <argument
            android:name="isEditVideo"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
        <argument
            android:name="isVideoCompress"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
        <argument
            android:name="isVideoToGIF"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
        <argument
            android:name="isVideoMerger"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
        <argument
            android:name="addSticker"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
        <action
            android:id="@+id/action_videoTrimmerFragment_to_editVideoActivity"
            app:destination="@id/editVideoActivity"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popUpTo="@id/menu_edit" />
        <action
            android:id="@+id/action_videoTrimmerFragment_to_videoTrimmingActivity"
            app:destination="@id/videoTrimmingActivity"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popUpTo="@id/videoTrimmerFragment" />
        <action
            android:id="@+id/action_videoTrimmerFragment_to_videoCompressorFragment"
            app:destination="@id/videoCompressorFragment" />
        <action
            android:id="@+id/action_videoTrimmerFragment_to_videoMergerFragment"
            app:destination="@id/videoMergerFragment" />
        <action
            android:id="@+id/action_videoTrimmerFragment_to_addStickerFragment"
            app:destination="@id/addStickerFragment" />
    </fragment>
    <activity
        android:id="@+id/editVideoActivity"
        android:name="com.nkd.screenrecorder.activities.EditVideoActivity"
        android:label="@string/edit_video">
        <argument
            android:name="VIDEO_URL"
            app:argType="string" />
        <argument
            android:name="DRAFT_ID"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </activity>
    <activity
        android:id="@+id/videoTrimmingActivity"
        android:name="com.nkd.screenrecorder.activities.VideoTrimmingActivity"
        android:label="@string/video_trimming">
        <argument
            android:name="Url"
            app:argType="string" />
        <argument
            android:name="isVideoToGIF"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false" />
    </activity>
    <fragment
        android:id="@+id/editImageFragment"
        android:name="com.nkd.screenrecorder.fragments.EditImageFragment"
        android:label="@string/edit_image">
        <argument
            android:name="imageUrl"
            app:argType="string"
            app:nullable="false" />
    </fragment>
    <fragment
        android:id="@+id/imageEditFragment"
        android:name="com.nkd.screenrecorder.fragments.ImageEditFragment"
        android:label="@string/select_image">
        <action
            android:id="@+id/action_imageEditFragment_to_imagePreviewFragment"
            app:destination="@id/imagePreviewFragment" />
    </fragment>
    <fragment
        android:id="@+id/videoCompressorFragment"
        android:name="com.nkd.screenrecorder.fragments.VideoCompressorFragment"
        android:label="">
        <argument
            android:name="videoUrl"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/videoMergerFragment"
        android:name="com.nkd.screenrecorder.fragments.VideoMergerFragment"
        android:label="">
        <argument
            android:name="videoUrls"
            app:argType="string[]"
            app:nullable="false" />
        <action
            android:id="@+id/action_videoMergerFragment_to_videoTrimmerFragment"
            app:destination="@id/videoTrimmerFragment" />
    </fragment>
    <fragment
        android:id="@+id/addStickerFragment"
        android:name="com.nkd.screenrecorder.fragments.AddStickerFragment"
        android:label="">
        <argument
            android:name="videoUrl"
            app:argType="string"
            app:nullable="false" />
    </fragment>

</navigation>