<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: compact switch thumb, 18dp circle (24dp tall incl. 3dp gaps), white — coloured by
     thumbTint (@color/settings_switch_thumb, MULTIPLY). Off: thin grey outline (kept by MULTIPLY). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:top="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <solid android:color="@android:color/white" />
                    <size android:width="18dp" android:height="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <solid android:color="@android:color/white" />
                    <stroke android:width="1dp" android:color="@color/settings_switch_thumb_outline" />
                    <size android:width="18dp" android:height="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
