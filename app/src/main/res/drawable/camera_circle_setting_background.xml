<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <corners android:radius="0dp" />
            <stroke android:width="1dp" android:color="@color/primaryColor" android:dashWidth="5dp" android:dashGap="3dp" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="oval">
            <corners android:radius="0dp" />
            <stroke android:width="1dp" android:color="@color/black" android:dashWidth="5dp" android:dashGap="3dp" />
        </shape>
    </item>
</selector>