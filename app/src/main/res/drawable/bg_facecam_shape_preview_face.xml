<?xml version="1.0" encoding="utf-8"?>
<!-- Facecam shape sheet: "Face only" preview - no background, just a dashed outline -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.5dp"
        android:color="@color/facecam_shape_preview_icon"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="8dp" />
</shape>
