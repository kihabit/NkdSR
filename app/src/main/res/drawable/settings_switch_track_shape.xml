<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: compact switch track shape, 44×24dp, white — coloured by trackTint
     (@color/settings_switch_track). The 3dp padding is the thumb's gap from the track edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="12dp" />
    <size android:width="44dp" android:height="24dp" />
    <padding android:left="3dp" android:right="3dp" />
</shape>
