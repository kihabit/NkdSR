<?xml version="1.0" encoding="utf-8"?>
<!-- Recording notification: pill card around the live timer (recording) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notif_timer_card_bg" />
    <stroke
        android:width="@dimen/notif_timer_card_border"
        android:color="@color/notif_timer_card_border" />
    <corners android:radius="@dimen/notif_timer_card_radius" />
</shape>
